{
  "version": 3,
  "configurePresets": [
    {
      "name": "settings",
      "hidden": true,
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/../../tools/vcpkg"
      }
    },
    {
      "name": "debug",
      "inherits": [
        "win_debug",
        "settings"
      ],
      "environment": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/../cth/install/win_debug/"
      }
    },
    {
      "name": "release",
      "inherits": [
        "win_release",
        "settings"
      ],
      "environment": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/../cth/install/win_release/"
      }
    }
  ]
}