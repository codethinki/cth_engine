// compute shader: set 0 binding 0 sampled images, binding 1 samplers, binding 2 storage images,
// push data `uint` indices: stores the center of the sampled image at texel 0 of the storage image
#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 1) in;

layout(set = 0, binding = 0) uniform texture2D textures[];
layout(set = 0, binding = 1) uniform sampler samplers[];
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D images[];

layout(push_constant) uniform Push {
    uint textureIdx;
    uint samplerIdx;
    uint imageIdx;
} push;

void main() {
    vec4 color = textureLod(sampler2D(textures[push.textureIdx], samplers[push.samplerIdx]), vec2(0.5), 0.0);
    imageStore(images[push.imageIdx], ivec2(0), color);
}
