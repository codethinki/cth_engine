#TEMP until MSVC has #embed
# writes a SPIR-V file as a header with a constexpr array of its words, run: cmake -P
# -DSPIRV_FILE: the SPIR-V of glslc, little endian words
# -DHEADER_FILE: the header to write
# -DARRAY_NAME: the name of the array in timgui::dev::shaders

foreach (VAR SPIRV_FILE HEADER_FILE ARRAY_NAME)
    if (NOT DEFINED ${VAR})
        message(FATAL_ERROR "spirv_header.cmake: -D${VAR} is missing")
    endif ()
endforeach ()

file(READ "${SPIRV_FILE}" SPIRV_BYTES HEX)
string(LENGTH "${SPIRV_BYTES}" SPIRV_HEX_LENGTH)
math(EXPR SPIRV_REST "${SPIRV_HEX_LENGTH} % 8")
if (SPIRV_HEX_LENGTH EQUAL 0 OR NOT SPIRV_REST EQUAL 0)
    message(FATAL_ERROR "spirv_header.cmake: ${SPIRV_FILE} is no sequence of 32 bit words")
endif ()

# 8 hex digits per word, the bytes of a word reversed: little endian
string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1;" SPIRV_WORDS "${SPIRV_BYTES}")
list(POP_BACK SPIRV_WORDS)
list(GET SPIRV_WORDS 0 SPIRV_MAGIC)
if (NOT SPIRV_MAGIC STREQUAL "0x07230203")
    message(FATAL_ERROR "spirv_header.cmake: ${SPIRV_FILE} has no little endian SPIR-V magic number")
endif ()
list(LENGTH SPIRV_WORDS SPIRV_WORD_COUNT)

# 8 words per line
set(SPIRV_LINES "")
set(SPIRV_LINE "")
set(SPIRV_LINE_WORDS 0)
foreach (WORD ${SPIRV_WORDS})
    string(APPEND SPIRV_LINE " ${WORD},")
    math(EXPR SPIRV_LINE_WORDS "${SPIRV_LINE_WORDS} + 1")
    if (SPIRV_LINE_WORDS EQUAL 8)
        string(APPEND SPIRV_LINES "   ${SPIRV_LINE}\n")
        set(SPIRV_LINE "")
        set(SPIRV_LINE_WORDS 0)
    endif ()
endforeach ()
if (NOT SPIRV_LINE_WORDS EQUAL 0)
    string(APPEND SPIRV_LINES "   ${SPIRV_LINE}\n")
endif ()

get_filename_component(SPIRV_NAME "${SPIRV_FILE}" NAME)
file(
        WRITE "${HEADER_FILE}"
        "#pragma once\n"
        "// generated by timgui/cmake/spirv_header.cmake from ${SPIRV_NAME}, do not edit\n"
        "#include <array>\n"
        "#include <cstdint>\n"
        "\n"
        "\n"
        "namespace timgui::dev::shaders {\n"
        "inline constexpr std::array<uint32_t, ${SPIRV_WORD_COUNT}> ${ARRAY_NAME}{\n"
        "${SPIRV_LINES}"
        "};\n"
        "}\n"
)
