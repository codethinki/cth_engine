{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/lib/cth_cmake/toolchain.cmake",
        "cth_ROOT": "${sourceDir}/../cth/out/install/${presetName}"
      }
    },
    {
      "name": "add_tests",
      "hidden": true,
      "cacheVariables": {
        "JOLLY_ENABLE_TESTS": true
      }
    },
    {
      "name": "debug-base",
      "hidden": true,
      "inherits": [
        "base",
        "add_tests"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "inherits": [
        "base",
        "add_tests"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ninja-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}"
    },
    {
      "name": "msvc-base",
      "hidden": true,
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "clang-base",
      "hidden": true,
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "gcc-base",
      "hidden": true,
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "msvc_debug",
      "inherits": [
        "msvc-base",
        "debug-base"
      ]
    },
    {
      "name": "msvc_release",
      "inherits": [
        "msvc-base",
        "release-base"
      ]
    },
    {
      "name": "clang_debug",
      "inherits": [
        "clang-base",
        "debug-base"
      ]
    },
    {
      "name": "clang_release",
      "inherits": [
        "clang-base",
        "release-base"
      ]
    },
    {
      "name": "gcc_debug",
      "inherits": [
        "gcc-base",
        "debug-base"
      ]
    },
    {
      "name": "gcc_release",
      "inherits": [
        "gcc-base",
        "release-base"
      ]
    }
  ]
}
